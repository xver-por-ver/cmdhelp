#!/usr/bin/env bash
# Searchable command reference with a guided command-add flow.
set -euo pipefail

APP_NAME="cmdhelp"
DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/cmdhelp"
DATA_FILE="${CMDHELP_DATA_FILE:-${DATA_DIR}/commands.tsv}"

usage() {
  cat <<'USAGE'
Usage:
  cmdhelp             Open the searchable command overlay
  cmdhelp add         Add a command with a guided prompt
  cmdhelp edit        Edit a command and manage its examples
  cmdhelp remove      Remove a command and its examples
  cmdhelp list        Print all commands and descriptions
  cmdhelp --help      Show this help

In the command overlay, type to filter and press Enter to browse that command's
examples. Type to filter examples, then press Enter to print the selected example
to copy it to the clipboard. Press Esc (or Ctrl-C) to cancel either overlay.
USAGE
}

require_fzf() {
  if ! command -v fzf >/dev/null 2>&1; then
    printf '%s requires fzf. Install fzf, then try again.\n' "$APP_NAME" >&2
    return 1
  fi
}

# Keep each TSV record on one line and preserve the three non-empty fields.
clean_field() {
  local value=$1
  value=${value//$'\t'/ }
  value=${value//$'\r'/ }
  value=${value//$'\n'/ }
  printf '%s' "$value"
}

ensure_data_file() {
  mkdir -p -- "$(dirname -- "$DATA_FILE")"
  if [[ ! -e "$DATA_FILE" ]]; then
    cat >"$DATA_FILE" <<'DATA'
cat	Display a file's contents in the terminal	cat notes.txt; cat -n notes.txt
cd	Change the current directory	cd ~/Downloads; cd -
chmod	Change file permissions	chmod +x script.sh
cp	Copy files or directories	cp report.txt backup.txt; cp -r src/ src-backup/
df	Show free disk space	df -h; df -i
diff	Compare two files	diff -u old.txt new.txt; diff -rq folder-a/ folder-b/
find	Find files by name or type	find . -name '*.log'; find . -type f -mtime -1
git status	Show the state of the working tree	git status --short; git status
less	Read a file one screen at a time	less /var/log/system.log
ls	List files and directories	ls -lah; ls -lt
mkdir	Create a directory	mkdir reports; mkdir -p project/src
mv	Move or rename files	mv draft.txt final.txt; mv file.txt ~/Documents/
pwd	Print the current directory	pwd
rg	Search file contents quickly	rg 'TODO' .; rg -n 'timeout' src/
ssh	Connect to a remote machine	ssh user@example.com; ssh -i ~/.ssh/key user@server
tar	Create or extract a tar archive	tar -czf archive.tar.gz folder/; tar -xzf archive.tar.gz
which	Show which executable will run	which python3; command -v git
DATA
  fi
}

list_commands() {
  ensure_data_file
  if [[ ! -s "$DATA_FILE" ]]; then
    printf 'No commands saved yet. Add one with: %s add\n' "$APP_NAME"
    return
  fi
  awk -F '\t' 'NF >= 3 && $1 != "" { printf "%-24s %s\n", $1, $2 }' "$DATA_FILE" | LC_ALL=C sort -f
}

add_command() {
  ensure_data_file
  local command_name description examples example
  local -a EXAMPLES=()
  printf 'Command: '
  IFS= read -r command_name || return 1
  command_name=$(clean_field "$command_name")
  if [[ -z "$command_name" ]]; then
    printf 'A command name is required. Nothing was added.\n' >&2
    return 1
  fi

  if awk -F '\t' -v key="$command_name" '$1 == key { found=1 } END { exit !found }' "$DATA_FILE"; then
    printf '“%s” is already in the command list. Nothing was added.\n' "$command_name" >&2
    return 1
  fi

  printf 'Brief description: '
  IFS= read -r description || return 1
  description=$(clean_field "$description")
  if [[ -z "$description" ]]; then
    printf 'A description is required. Nothing was added.\n' >&2
    return 1
  fi

  while true; do
    printf '\nExamples so far:\n'
    if ((${#EXAMPLES[@]})); then
      printf '  %s\n' "${EXAMPLES[@]}"
    else
      printf '  (none yet)\n'
    fi
    printf 'Example command (leave blank when done): '
    IFS= read -r example || return 1
    example=$(clean_field "$example")
    [[ -z "$example" ]] && break
    if example_exists "$example"; then
      printf 'That example is already in this command. Enter a different one.\n' >&2
      continue
    fi
    EXAMPLES+=("$example")
  done

  # ASCII unit separator keeps example text (including semicolons) intact.
  examples=$(encode_examples)
  printf '%s\t%s\t%s\n' "$command_name" "$description" "$examples" >>"$DATA_FILE"
  printf 'Added “%s”.\n' "$command_name"
}

decode_examples() {
  local stored=$1 item_index
  EXAMPLES=()
  [[ -n "$stored" ]] || return 0
  if [[ "$stored" == *$'\x1f'* ]]; then
    IFS=$'\x1f' read -r -a EXAMPLES <<< "$stored"
  elif [[ "$stored" == *'; '* ]]; then
    # Read entries saved by earlier versions of cmdhelp.
    IFS=';' read -r -a EXAMPLES <<< "$stored"
    for item_index in "${!EXAMPLES[@]}"; do
      EXAMPLES[$item_index]=${EXAMPLES[$item_index]# }
    done
  else
    EXAMPLES=("$stored")
  fi
}

encode_examples() {
  local IFS=$'\x1f'
  printf '%s' "${EXAMPLES[*]}"
}

example_exists() {
  local candidate=$1 skip_index=${2:--1} example_index
  for example_index in "${!EXAMPLES[@]}"; do
    [[ "$example_index" == "$skip_index" ]] && continue
    [[ "${EXAMPLES[$example_index]}" == "$candidate" ]] && return 0
  done
  return 1
}

manage_examples() {
  local selected kind example_index label action example replacement answer
  while true; do
    if ! selected=$(
      {
        printf 'A\t\t+ Add example\n'
        for example_index in "${!EXAMPLES[@]}"; do
          printf 'I\t%s\t%s\n' "$example_index" "${EXAMPLES[$example_index]}"
        done
        printf 'D\t\tDone\n'
      } | fzf --height='65%' --layout=reverse --border --cycle \
          --delimiter=$'\t' --with-nth=3 \
          --prompt='Examples> ' --header='Examples are listed here · select one to edit or delete' --no-multi); then
      return 0
    fi
    IFS=$'\t' read -r kind example_index label <<< "$selected"
    case "$kind" in
      A)
        printf '\nCurrent examples:\n'
        if ((${#EXAMPLES[@]})); then
          printf '  %s\n' "${EXAMPLES[@]}"
        else
          printf '  (none yet)\n'
        fi
        printf 'Example command: '
        IFS= read -r example || return 0
        example=$(clean_field "$example")
        if [[ -n "$example" ]]; then
          if example_exists "$example"; then
            printf 'That example is already in this command.\n' >&2
          else
            EXAMPLES+=("$example")
          fi
        fi
        ;;
      I)
        if ! action=$(printf '%s\n' 'Edit example' 'Delete example' 'Back' \
          | fzf --height='40%' --layout=reverse --border --cycle \
              --prompt='Example> ' --header="${EXAMPLES[$example_index]}" --no-multi); then
          continue
        fi
        case "$action" in
          'Edit example')
          printf '\nCurrent examples:\n'
          printf '  %s\n' "${EXAMPLES[@]}"
          printf 'New text (blank keeps the current example): '
          IFS= read -r replacement || return 0
          replacement=$(clean_field "$replacement")
          if [[ -n "$replacement" ]]; then
            if example_exists "$replacement" "$example_index"; then
              printf 'That example is already in this command; the current example was kept.\n' >&2
            else
              EXAMPLES[$example_index]=$replacement
            fi
          fi
          ;;
          'Delete example')
          printf 'Delete this example? [y/N]: '
          IFS= read -r answer || return 0
          case "$answer" in
            y|Y|yes|YES)
          unset "EXAMPLES[$example_index]"
          EXAMPLES=("${EXAMPLES[@]}")
              ;;
          esac
          ;;
        esac
        ;;
      D) return 0 ;;
    esac
  done
}

edit_command() {
  ensure_data_file
  require_fzf
  local selected_row command_name old_name description stored_examples action replacement
  local encoded_examples temp_file line found
  if ! selected_row=$(awk -F '\t' 'NF >= 3 && $1 != "" { print $1 "\t" $2 "\t" $3 }' "$DATA_FILE" \
    | LC_ALL=C sort -f -t $'\t' -k1,1 \
    | fzf --height='80%' --layout=reverse --border --cycle \
        --delimiter=$'\t' --with-nth=1,2 \
        --prompt='Edit command> ' --header='Choose a command · Esc: cancel' \
        --no-multi); then
    return 0
  fi

  IFS=$'\t' read -r command_name description stored_examples <<< "$selected_row"
  old_name=$command_name
  decode_examples "$stored_examples"

  while true; do
    if ! action=$(printf '%s\n' 'Command name' 'Description' 'Manage examples' 'Delete command' 'Done' \
      | fzf --height='45%' --layout=reverse --border --cycle \
          --prompt="Edit ${command_name}> " --header='Choose what to edit' --no-multi); then
      return 0
    fi
    case "$action" in
      'Command name')
        printf 'New command name (blank keeps the current name): '
        IFS= read -r replacement || return 0
        replacement=$(clean_field "$replacement")
        if [[ -n "$replacement" && "$replacement" != "$command_name" ]]; then
          if awk -F '\t' -v key="$replacement" -v old="$old_name" '$1 == key && $1 != old { found=1 } END { exit !found }' "$DATA_FILE"; then
            printf '“%s” is already in the command list.\n' "$replacement" >&2
          else
            command_name=$replacement
          fi
        fi
        ;;
      Description)
        printf 'New description (blank keeps the current description): '
        IFS= read -r replacement || return 0
        replacement=$(clean_field "$replacement")
        if [[ -n "$replacement" ]]; then description=$replacement; fi
        ;;
      'Manage examples') manage_examples ;;
      'Delete command')
        if confirm_and_remove "$old_name"; then return 0; fi
        ;;
      Done) break ;;
    esac
  done

  encoded_examples=$(encode_examples)
  temp_file=$(mktemp "${DATA_FILE}.XXXXXX") || return 1
  found=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$old_name"$'\t'* ]]; then
      printf '%s\t%s\t%s\n' "$command_name" "$description" "$encoded_examples" >> "$temp_file"
      found=1
    else
      printf '%s\n' "$line" >> "$temp_file"
    fi
  done < "$DATA_FILE"
  if ((found)); then
    mv -- "$temp_file" "$DATA_FILE"
    printf 'Updated “%s”.\n' "$command_name"
  else
    rm -f -- "$temp_file"
    printf 'Could not find “%s” in the command list.\n' "$old_name" >&2
    return 1
  fi
}

remove_command_entry() {
  local target=$1 temp_file line removed=0
  temp_file=$(mktemp "${DATA_FILE}.XXXXXX") || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$target"$'\t'* ]]; then
      removed=1
    else
      printf '%s\n' "$line" >> "$temp_file"
    fi
  done < "$DATA_FILE"
  if ((removed)); then
    mv -- "$temp_file" "$DATA_FILE"
    printf 'Removed “%s” and its examples.\n' "$target"
  else
    rm -f -- "$temp_file"
    printf 'Could not find “%s” in the command list.\n' "$target" >&2
    return 1
  fi
}

confirm_and_remove() {
  local target=$1 answer
  printf 'Remove “%s” and all its examples? [y/N]: ' "$target"
  IFS= read -r answer || return 1
  case "$answer" in
    y|Y|yes|YES) remove_command_entry "$target" ;;
    *) printf 'Kept “%s”.\n' "$target"; return 1 ;;
  esac
}

remove_command() {
  ensure_data_file
  require_fzf
  local selected_row command_name description stored_examples
  if ! selected_row=$(awk -F '\t' 'NF >= 3 && $1 != "" { print $1 "\t" $2 "\t" $3 }' "$DATA_FILE" \
    | LC_ALL=C sort -f -t $'\t' -k1,1 \
    | fzf --height='80%' --layout=reverse --border --cycle \
        --delimiter=$'\t' --with-nth=1,2 \
        --prompt='Remove command> ' --header='Choose a command · Esc: cancel' \
        --no-multi); then
    return 0
  fi
  IFS=$'\t' read -r command_name description stored_examples <<< "$selected_row"
  confirm_and_remove "$command_name" || true
}

show_overlay() {
  ensure_data_file
  require_fzf
  if [[ ! -s "$DATA_FILE" ]]; then
    printf 'No commands saved yet. Add one with: %s add\n' "$APP_NAME"
    return
  fi
  local selected_row command_name description stored_examples examples selected_example
  # Enter in this searchable command overlay opens the selected command's examples.
  if ! selected_row=$(awk -F '\t' 'NF >= 3 && $1 != "" { print $1 "\t" $2 "\t" $3 }' "$DATA_FILE" |
    LC_ALL=C sort -f -t $'\t' -k1,1 |
    fzf --height='80%' --layout=reverse --border --cycle \
      --delimiter=$'\t' --with-nth=1,2 \
      --prompt='Commands> ' \
      --header='Type to filter · Enter: examples · Esc: close' \
      --preview='printf "Description: %s\\n\\nExamples:\\n" {2}; printf "%s\\n" {3} | tr "\\037" "\\n" | sed "s/; /\\n/g"' \
      --preview-window='right:50%:wrap' \
      --no-multi); then
    return 0
  fi

  IFS=$'\t' read -r command_name description stored_examples <<<"$selected_row"
  decode_examples "$stored_examples"
  if ((${#EXAMPLES[@]} == 0)); then
    printf 'No examples saved for %s.\n' "$command_name" >&2
    return 0
  fi
  examples=$(printf '%s\n' "${EXAMPLES[@]}")

  if ! selected_example=$(printf '%s\n' "$examples" |
    fzf --height='60%' --layout=reverse --border --cycle \
      --prompt='Examples> ' \
      --header="${command_name} · type to filter · Enter: copy example · Esc: back" \
      --no-multi); then
    return 0
  fi

  if copy_to_clipboard "$selected_example"; then
    printf 'Copied to clipboard: %s\n' "$selected_example" >&2
  else
    printf 'Could not copy the example: install wl-copy, xclip, xsel, pbcopy, or clip.exe.\n' >&2
    return 1
  fi
}

copy_to_clipboard() {
  local value=$1
  if command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$value" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$value" | xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$value" | xsel --clipboard --input
  elif command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$value" | pbcopy
  elif command -v clip.exe >/dev/null 2>&1; then
    printf '%s' "$value" | clip.exe
  else
    return 1
  fi
}

main() {
  case "${1:-}" in
  '' | browse) show_overlay ;;
  add) add_command ;;
  edit) edit_command ;;
  remove|delete) remove_command ;;
  list) list_commands ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    return 2
    ;;
  esac
}

main "$@"
